---
import { getMdiTier } from '../lib/report';
import type { LeaderboardEntry } from '../lib/types';

type Props = {
  items: LeaderboardEntry[];
};

const { items } = Astro.props;

const rankStyle: Record<number, { background: string; accent: string }> = {
  1: { background: 'linear-gradient(180deg, rgba(217, 119, 6, 0.14), #ffffff 72%)', accent: '#b45309' },
  2: { background: 'linear-gradient(180deg, rgba(100, 116, 139, 0.16), #ffffff 72%)', accent: '#475569' },
  3: { background: 'linear-gradient(180deg, rgba(180, 83, 9, 0.12), #ffffff 72%)', accent: '#9a3412' },
};
---

<section class="surface podium">
  <div class="podium-head">
    <h2 class="section-title">榜首三席</h2>
    <p class="section-copy">按命中次数排序，次数相同时比 MDI</p>
  </div>

  <div class="podium-grid">
    {
      items.map((item) => {
        const tier = getMdiTier(item.mdi);
        const style = rankStyle[item.rank] ?? rankStyle[3];

        return (
          <article class="podium-card" style={`background:${style.background};`}>
            <div class="podium-top">
              <span class="podium-rank" style={`color:${style.accent};`}>
                #{item.rank}
              </span>
              <span
                class="podium-tier"
                style={`color:${tier.color};border-color:${tier.color}44;background:${tier.color}12;`}
              >
                {tier.badge}
              </span>
            </div>
            <div class="podium-body">
              <img class="podium-avatar" src={item.avatarUrl} alt="" width="44" height="44" />
              <div class="podium-identity">
                <div class="podium-name">{item.displayName}</div>
                <div class="podium-handle">@{item.login}</div>
              </div>
            </div>
            <div class="podium-meta">
              <span>
                <span class="numeric podium-strong">{item.droolCount.toLocaleString('en-US')}</span> 次命中
              </span>
              <span>
                MDI <span class="numeric podium-strong">{item.mdi.toFixed(2)}</span>
              </span>
            </div>
            <a class="podium-link" href={`/u/${encodeURIComponent(item.login)}`}>
              查看他的模型明细
            </a>
          </article>
        );
      })
    }
  </div>
</section>

<style>
  .podium {
    padding: 18px;
    margin-bottom: 16px;
  }

  .podium-head {
    margin-bottom: 14px;
  }

  .podium-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
  }

  .podium-card {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 16px;
  }

  .podium-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin-bottom: 12px;
  }

  .podium-rank {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 20px;
    font-weight: 700;
  }

  .podium-tier {
    border: 1px solid;
    border-radius: 999px;
    padding: 3px 10px;
    font-size: 12px;
    font-weight: 600;
  }

  .podium-body {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 14px;
  }

  .podium-avatar {
    width: 44px;
    height: 44px;
    border-radius: var(--radius-sm);
    flex: 0 0 auto;
  }

  .podium-name {
    font-size: 17px;
    font-weight: 700;
    line-height: 1.2;
  }

  .podium-handle {
    color: var(--muted);
    font-size: 12px;
    margin-top: 3px;
  }

  .podium-meta {
    display: flex;
    justify-content: space-between;
    gap: 10px;
    color: var(--text-secondary);
    font-size: 13px;
    padding-top: 12px;
    border-top: 1px solid var(--border);
  }

  .podium-strong {
    font-weight: 700;
  }

  .podium-link {
    display: inline-block;
    margin-top: 12px;
    font-size: 13px;
    font-weight: 600;
    color: var(--primary);
    text-decoration: none;
  }

  .podium-link:hover,
  .podium-link:focus-visible {
    text-decoration: underline;
  }

  @media (max-width: 900px) {
    .podium-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
