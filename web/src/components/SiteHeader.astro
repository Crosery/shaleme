---
import type { Viewer } from '../lib/types';

type Props = {
  title: string;
  subtitle: string;
  viewer: Viewer | null;
  active: 'leaderboard' | 'models';
};

const { title, subtitle, viewer, active } = Astro.props;

const navItems = [
  { key: 'leaderboard' as const, label: '总榜', href: '/' },
  { key: 'models' as const, label: '模型榜', href: '/models' },
];
---

<header class="site-header">
  <a class="brand" href="/">
    <span class="brand-mark" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none">
        <path
          d="M4 5.5h16M4 12h16M4 18.5h10"
          stroke="currentColor"
          stroke-width="2.2"
          stroke-linecap="round"
        />
      </svg>
    </span>
    <span class="brand-copy">
      <span class="brand-title">{title}</span>
      <span class="brand-subtitle">{subtitle}</span>
    </span>
  </a>

  <nav class="site-nav" aria-label="主导航">
    {
      navItems.map((item) => (
        <a href={item.href} class:list={['nav-chip', active === item.key && 'is-active']}>
          {item.label}
        </a>
      ))
    }
  </nav>

  <div class="header-actions">
    {
      viewer ? (
        <div class="viewer">
          <a class="viewer-link" href={`/u/${encodeURIComponent(viewer.login)}`}>
            <img class="viewer-avatar" src={viewer.avatarUrl} alt="" width="28" height="28" />
            <span class="viewer-name">{viewer.displayName}</span>
          </a>
          <a class="text-link" href="/api/auth/logout">
            退出
          </a>
        </div>
      ) : (
        <a class="signin-link" href="/api/auth/github/login">
          <svg viewBox="0 0 16 16" aria-hidden="true" class="signin-icon">
            <path
              fill="currentColor"
              d="M8 0C3.58 0 0 3.58 0 8a8 8 0 0 0 5.47 7.59c.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.57 7.57 0 0 1 4 0c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
            />
          </svg>
          用 GitHub 登录
        </a>
      )
    }
    <a
      class="repo-link"
      href="https://github.com/Crosery/shaleme"
      target="_blank"
      rel="noreferrer"
      aria-label="源码仓库"
    >
      <svg viewBox="0 0 16 16" aria-hidden="true" class="signin-icon">
        <path
          fill="currentColor"
          d="M8 0C3.58 0 0 3.58 0 8a8 8 0 0 0 5.47 7.59c.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.57 7.57 0 0 1 4 0c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
        />
      </svg>
    </a>
  </div>
</header>

<style>
  .site-header {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 16px;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--border);
    margin-bottom: 22px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
  }

  .brand-mark {
    width: 40px;
    height: 40px;
    border-radius: var(--radius);
    background: linear-gradient(135deg, var(--primary), #6366f1);
    color: #ffffff;
    display: grid;
    place-items: center;
    box-shadow: var(--shadow-sm);
  }

  .brand-mark svg {
    width: 22px;
    height: 22px;
  }

  .brand-copy {
    display: grid;
    gap: 2px;
  }

  .brand-title {
    font-size: 16px;
    font-weight: 700;
  }

  .brand-subtitle {
    font-size: 12px;
    color: var(--muted);
  }

  .site-nav {
    display: flex;
    justify-content: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .nav-chip {
    text-decoration: none;
    color: var(--muted);
    font-size: 13px;
    font-weight: 600;
    border: 1px solid var(--border);
    background: var(--surface);
    padding: 7px 12px;
    border-radius: var(--radius-sm);
    transition:
      border-color 140ms ease,
      color 140ms ease,
      background 140ms ease;
  }

  .nav-chip.is-active {
    color: var(--primary);
    border-color: rgba(79, 70, 229, 0.32);
    background: var(--primary-soft);
  }

  .header-actions {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    justify-content: flex-end;
  }

  .viewer {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    border: 1px solid var(--border);
    background: var(--surface);
    border-radius: var(--radius-sm);
    padding: 5px 10px 5px 5px;
  }

  .viewer-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    font-weight: 600;
    font-size: 13px;
  }

  .viewer-avatar {
    width: 28px;
    height: 28px;
    border-radius: 6px;
  }

  .text-link {
    font-size: 12px;
    color: var(--muted);
    text-decoration: none;
  }

  .text-link:hover,
  .text-link:focus-visible {
    color: var(--rose);
  }

  .signin-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    font-size: 13px;
    font-weight: 600;
    padding: 8px 12px;
    border-radius: var(--radius-sm);
    border: 1px solid #24292f;
    background: #24292f;
    color: #ffffff;
  }

  .signin-icon {
    width: 15px;
    height: 15px;
    flex: 0 0 auto;
  }

  .repo-link {
    width: 38px;
    height: 38px;
    border-radius: var(--radius-sm);
    display: grid;
    place-items: center;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text-secondary);
  }

  @media (max-width: 820px) {
    .site-header {
      grid-template-columns: 1fr;
      justify-items: start;
    }

    .site-nav {
      justify-content: flex-start;
    }

    .header-actions {
      justify-content: flex-start;
    }
  }
</style>
