---
type Item = {
  label: string;
  value: string;
  hint?: string;
  tone: 'indigo' | 'amber' | 'emerald' | 'rose';
};

type Props = {
  items: Item[];
};

const { items } = Astro.props;

const tones = {
  indigo: { border: 'rgba(79, 70, 229, 0.24)', bg: 'rgba(79, 70, 229, 0.06)', value: '#4f46e5' },
  amber: { border: 'rgba(217, 119, 6, 0.24)', bg: 'rgba(217, 119, 6, 0.07)', value: '#b45309' },
  emerald: { border: 'rgba(5, 150, 105, 0.24)', bg: 'rgba(5, 150, 105, 0.07)', value: '#047857' },
  rose: { border: 'rgba(225, 29, 72, 0.22)', bg: 'rgba(225, 29, 72, 0.06)', value: '#be123c' },
};
---

<div class="stats-strip">
  {
    items.map((item) => (
      <div
        class="stat-box"
        style={`border-color:${tones[item.tone].border};background:${tones[item.tone].bg};`}
      >
        <div class="stat-label">{item.label}</div>
        <div class="stat-value numeric" style={`color:${tones[item.tone].value};`}>
          {item.value}
        </div>
        {item.hint && <div class="stat-hint">{item.hint}</div>}
      </div>
    ))
  }
</div>

<style>
  .stats-strip {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
    margin-bottom: 16px;
  }

  .stat-box {
    border: 1px solid;
    border-radius: var(--radius);
    padding: 14px 16px;
  }

  .stat-label {
    font-size: 12px;
    color: var(--muted);
    margin-bottom: 8px;
  }

  .stat-value {
    font-size: 26px;
    line-height: 1.1;
    font-weight: 700;
  }

  .stat-hint {
    margin-top: 6px;
    font-size: 12px;
    color: var(--muted);
  }

  @media (max-width: 900px) {
    .stats-strip {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 520px) {
    .stats-strip {
      grid-template-columns: 1fr;
    }
  }
</style>
