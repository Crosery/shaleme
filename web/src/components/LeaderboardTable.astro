---
import { getMdiTier } from '../lib/report';
import type { LeaderboardEntry } from '../lib/types';

type Props = {
  entries: LeaderboardEntry[];
};

const { entries } = Astro.props;

function formatDate(value: number) {
  if (!value) {
    return '-';
  }

  return new Date(value).toISOString().slice(0, 10);
}
---

<section class="surface leaderboard">
  <div class="leaderboard-head">
    <div>
      <h2 class="section-title">总榜</h2>
      <p class="section-copy">
        排序：命中次数降序，其次 MDI 降序，其次 assistant 消息数降序，最后先提交者优先
      </p>
    </div>
    <span class="row-count numeric">共 {entries.length} 行</span>
  </div>

  <div class="table-shell">
    <table>
      <thead>
        <tr>
          <th class="col-rank">名次</th>
          <th>账号</th>
          <th class="col-number">"你说得对"命中</th>
          <th class="col-number">assistant 消息</th>
          <th class="col-number">MDI</th>
          <th class="col-number">模型数</th>
          <th class="col-number">会话数</th>
          <th class="col-date">更新时间</th>
        </tr>
      </thead>
      <tbody>
        {
          entries.length === 0 ? (
            <tr>
              <td colspan="8" class="empty-cell">
                还没有人提交。在本机跑一次 <span class="numeric">npx shaleme</span>，在报告页点「上传到榜单」。
              </td>
            </tr>
          ) : (
            entries.map((entry) => {
              const tier = getMdiTier(entry.mdi);

              return (
                <tr>
                  <td class="col-rank numeric rank-cell">#{entry.rank}</td>
                  <td>
                    <a class="account-cell" href={`/u/${encodeURIComponent(entry.login)}`}>
                      <img
                        class="account-avatar"
                        src={entry.avatarUrl}
                        alt=""
                        width="36"
                        height="36"
                        loading="lazy"
                      />
                      <span>
                        <span class="account-name">{entry.displayName}</span>
                        <span class="account-handle">@{entry.login}</span>
                      </span>
                    </a>
                  </td>
                  <td class="col-number numeric strong">
                    {entry.droolCount.toLocaleString('en-US')}
                  </td>
                  <td class="col-number numeric muted-cell">
                    {entry.assistantMessages.toLocaleString('en-US')}
                  </td>
                  <td class="col-number">
                    <span class="mdi-value numeric">{entry.mdi.toFixed(2)}</span>
                    <span
                      class="mdi-tier"
                      style={`color:${tier.color};border-color:${tier.color}44;background:${tier.color}12;`}
                    >
                      {tier.badge}
                    </span>
                  </td>
                  <td class="col-number numeric muted-cell">{entry.modelCount}</td>
                  <td class="col-number numeric muted-cell">{entry.sessionsScanned}</td>
                  <td class="col-date numeric muted-cell">{formatDate(entry.updatedAt)}</td>
                </tr>
              );
            })
          )
        }
      </tbody>
    </table>
  </div>
</section>

<style>
  .leaderboard {
    padding: 18px;
  }

  .leaderboard-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 14px;
    margin-bottom: 14px;
    flex-wrap: wrap;
  }

  .row-count {
    font-size: 12px;
    color: var(--muted);
    border: 1px solid var(--border);
    background: var(--bg-subtle);
    border-radius: 999px;
    padding: 4px 10px;
  }

  .table-shell {
    overflow: auto;
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  table {
    width: 100%;
    border-collapse: collapse;
  }

  th,
  td {
    text-align: left;
    padding: 12px;
    border-bottom: 1px solid var(--border);
    font-size: 14px;
    vertical-align: middle;
    white-space: nowrap;
  }

  th {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--muted);
    background: var(--bg-subtle);
    position: sticky;
    top: 0;
  }

  tbody tr:last-child td {
    border-bottom: none;
  }

  tbody tr:hover {
    background: rgba(79, 70, 229, 0.03);
  }

  .col-rank {
    width: 68px;
  }

  .col-number {
    text-align: right;
  }

  .col-date {
    text-align: right;
    width: 110px;
  }

  .rank-cell {
    font-weight: 700;
    color: var(--primary);
  }

  .strong {
    font-weight: 700;
  }

  .muted-cell {
    color: var(--muted);
  }

  .account-cell {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
  }

  .account-avatar {
    width: 36px;
    height: 36px;
    border-radius: var(--radius-sm);
    object-fit: cover;
    flex: 0 0 auto;
  }

  .account-name {
    display: block;
    font-weight: 600;
  }

  .account-handle {
    display: block;
    color: var(--muted);
    font-size: 12px;
    margin-top: 2px;
  }

  .mdi-value {
    font-weight: 700;
  }

  .mdi-tier {
    display: inline-block;
    margin-left: 8px;
    border: 1px solid;
    border-radius: 999px;
    padding: 2px 8px;
    font-size: 11px;
    font-weight: 600;
  }

  .empty-cell {
    text-align: center;
    color: var(--muted);
    padding: 36px 12px;
    white-space: normal;
  }

  @media (max-width: 820px) {
    .leaderboard {
      padding: 14px;
    }
  }
</style>
