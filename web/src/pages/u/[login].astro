---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import StatusBanner from '../../components/StatusBanner.astro';
import { getMdiTier } from '../../lib/report';
import { getSessionCookieName, readViewerFromCookie } from '../../lib/auth';
import { getLeaderboardProfileByLogin, hasDatabaseBinding } from '../../lib/db';

const login = Astro.params.login ?? '';
const viewer = await readViewerFromCookie(Astro.cookies.get(getSessionCookieName())?.value);
const databaseReady = hasDatabaseBinding();
const profile = databaseReady && login ? await getLeaderboardProfileByLogin(login) : null;
const state = Astro.url.searchParams.get('state') ?? '';
const rankValue = Number(Astro.url.searchParams.get('rank'));
const rank = Number.isFinite(rankValue) && rankValue > 0 ? Math.trunc(rankValue) : 0;

if (!profile) {
  Astro.response.status = 404;
}

const tier = profile ? getMdiTier(profile.score) : null;
const modelEntries = profile
  ? [...profile.report.modelEntries].sort((left, right) => right.mdi - left.mdi)
  : [];
const isSelf = Boolean(viewer && profile && viewer.githubId === profile.githubId);

function fmt(value: number) {
  return value.toLocaleString('en-US');
}

function formatDate(value: number) {
  if (!value) {
    return '-';
  }

  return new Date(value).toISOString().slice(0, 16).replace('T', ' ');
}
---

<BaseLayout
  title={profile ? `${profile.displayName} 的 shaleme 成绩` : '找不到这个用户'}
  description={
    profile
      ? `${profile.displayName} 在 shaleme 榜单排第 ${profile.rank} 名，分数 ${profile.score.toFixed(1)}。`
      : 'shaleme 榜单用户页'
  }
>
  <div class="wrap">
    {
      profile && tier ? (
        <>
          <header class="masthead">
            <div class="masthead-main">
              <div class="person">
                <img class="avatar" src={profile.avatarUrl} alt="" width="56" height="56" />
                <div>
                  <h1>{profile.displayName}</h1>
                  <a class="handle" href={profile.profileUrl} target="_blank" rel="noreferrer">
                    @{profile.login}
                  </a>
                  <p class="tier-line">
                    <span class="tier" style={`color:${tier.color};`}>{tier.badge}</span>
                    <span class="tagline">{tier.tagline}</span>
                  </p>
                </div>
              </div>
              <div class="rank-box">
                <span class="rank-label">名次</span>
                <span class="rank-value num">#{profile.rank}</span>
                <span
                  class="score-value num"
                  data-tip={`贝叶斯收缩后的分数 · 原始 MDI ${profile.mdi.toFixed(2)}`}
                >
                  {profile.score.toFixed(1)}
                </span>
              </div>
            </div>
            <div class="back-row">
              <a class="btn" href="/">← 榜单</a>
              {isSelf ? <a class="btn-text btn" href="/upload">更新成绩</a> : null}
            </div>
          </header>

          {isSelf ? <StatusBanner state={state} rank={rank} /> : null}

          <dl class="stats">
            <div class="stat">
              <dt>命中</dt>
              <dd class="num">{fmt(profile.droolCount)}</dd>
            </div>
            <div class="stat">
              <dt>消息</dt>
              <dd class="num">{fmt(profile.assistantMessages)}</dd>
            </div>
            <div class="stat">
              <dt>会话</dt>
              <dd class="num">{fmt(profile.sessionsScanned)}</dd>
            </div>
            <div class="stat">
              <dt>模型</dt>
              <dd class="num">{fmt(profile.modelCount)}</dd>
            </div>
          </dl>

          <section class="panel">
            <div class="panel-head">
              <h2>模型明细</h2>
              <span class="panel-meta num">{modelEntries.length} 个</span>
            </div>
            {
              modelEntries.length === 0 ? (
                <div class="empty-state">
                  <p>这次提交没有模型明细。升级 shaleme 重新生成报告即可带上。</p>
                </div>
              ) : (
                <table>
                  <thead>
                    <tr>
                      <th class="col-rank"></th>
                      <th>模型</th>
                      <th class="right">命中</th>
                      <th class="right">消息</th>
                      <th class="right">
                        <span data-tip="每千条 assistant 消息的「你说得对」次数">MDI</span>
                      </th>
                    </tr>
                  </thead>
                  <tbody>
                    {modelEntries.map((entry, index) => {
                      const entryTier = getMdiTier(entry.mdi);
                      return (
                        <tr>
                          <td class="col-rank">
                            <span class:list={['rank-num', 'num', index < 3 && 'podium']}>
                              {index + 1}
                            </span>
                          </td>
                          <td>
                            <span class="model-name">{entry.model}</span>
                            <span
                              class="mdi-bar"
                              aria-hidden="true"
                              style={`--w:${Math.min(100, Math.max(2, Math.round((entry.mdi / (modelEntries[0].mdi || 1)) * 100)))}%`}
                            >
                              <span class="mdi-fill" style={`background:${entryTier.color};`}></span>
                            </span>
                          </td>
                          <td class="right num">{fmt(entry.droolCount)}</td>
                          <td class="right num muted">{fmt(entry.totalMessages)}</td>
                          <td class="right">
                            <span class="score num" style={`color:${entryTier.color};`}>
                              {entry.mdi.toFixed(1)}
                            </span>
                          </td>
                        </tr>
                      );
                    })}
                  </tbody>
                </table>
              )
            }
          </section>

          <footer class="foot">
            提交于 <span class="num">{formatDate(profile.submittedAt)}</span> · CLI{" "}
            <span class="num">{profile.version || '未知'}</span> ·{" "}
            <a href="/">榜单</a>
          </footer>
        </>
      ) : (
        <div class="missing">
          <h1>找不到这个用户</h1>
          <p class="missing-copy">
            {login
              ? `榜单上还没有 @${login} 的成绩。`
              : '这个地址缺少用户名。'}
          </p>
          <a class="btn" href="/">回到榜单</a>
        </div>
      )
    }
  </div>
</BaseLayout>

<style>
  .masthead {
    padding: 44px 0 28px;
    border-bottom: 1px solid var(--line);
  }
  .masthead-main {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--s-5);
  }
  .person { display: flex; gap: var(--s-4); align-items: flex-start; }
  .avatar { border-radius: var(--r-field); border: 1px solid var(--line); }
  h1 {
    font-family: var(--font-serif);
    font-size: var(--fs-3xl);
    font-weight: 700;
    line-height: 1.2;
  }
  .handle {
    display: inline-block;
    color: var(--ink-3);
    font-size: var(--fs-sm);
    text-decoration: none;
    font-family: var(--font-mono);
  }
  .handle:hover { color: var(--accent-strong); }
  .tier-line { display: flex; align-items: baseline; gap: 10px; margin-top: 6px; }
  .tier { font-weight: 700; font-size: var(--fs-md); }
  .tagline { color: var(--ink-3); font-size: var(--fs-xs); }

  .rank-box { text-align: right; flex: 0 0 auto; }
  .rank-label {
    display: block;
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--ink-3);
  }
  .rank-value {
    display: block;
    font-family: var(--font-serif);
    font-size: 3.2rem;
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }
  .score-value {
    display: block;
    font-size: var(--fs-lg);
    font-weight: 700;
    color: var(--accent-strong);
  }
  .back-row { display: flex; gap: var(--s-3); margin-top: var(--s-5); }

  .stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--s-4);
    margin: var(--s-6) 0 0;
    padding: var(--s-5) 0;
    border-bottom: 1px solid var(--line);
  }
  .stat dt { font-size: 0.76rem; font-weight: 700; letter-spacing: 0.04em; color: var(--ink-3); }
  .stat dd { font-size: var(--fs-xl); font-weight: 700; letter-spacing: -0.01em; }

  .panel { margin-top: var(--s-6); }
  .panel-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: var(--s-3);
  }
  .panel-head h2 { font-size: var(--fs-lg); font-weight: 700; }
  .panel-meta { color: var(--ink-3); font-size: var(--fs-sm); }

  .col-rank { width: 56px; }
  .rank-num { font-size: 0.95rem; color: var(--ink-3); font-weight: 700; }
  .rank-num.podium {
    font-family: var(--font-serif);
    font-size: 1.7rem;
    color: var(--ink);
    line-height: 1;
  }
  .model-name {
    font-family: var(--font-mono);
    font-weight: 700;
    white-space: nowrap;
  }
  .muted { color: var(--ink-3); }
  .score { font-size: 1.05rem; font-weight: 700; letter-spacing: -0.01em; }
  .mdi-bar {
    display: block;
    height: 3px;
    margin-top: 6px;
    background: var(--line);
    border-radius: 999px;
    overflow: hidden;
    max-width: 220px;
  }
  .mdi-fill { display: block; height: 100%; width: var(--w); border-radius: 999px; }

  .foot {
    margin-top: var(--s-8);
    padding-top: var(--s-4);
    border-top: 1px solid var(--line);
    color: var(--ink-3);
    font-size: var(--fs-xs);
  }
  .foot a { color: inherit; }

  .missing { padding: var(--s-8) 0; }
  .missing h1 {
    font-family: var(--font-serif);
    font-size: var(--fs-3xl);
    margin-bottom: var(--s-3);
  }
  .missing-copy { color: var(--ink-2); margin-bottom: var(--s-5); }

  @media (max-width: 720px) {
    .masthead { padding-top: 24px; }
    .masthead-main { flex-direction: column; align-items: flex-start; }
    .rank-box { text-align: left; }
    .stats { grid-template-columns: repeat(2, 1fr); }
    td.right, th.right { padding-left: 8px; padding-right: 8px; }
  }
</style>
