---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import { getSessionCookieName, readViewerFromCookie } from '../lib/auth';
import { getModelDashboard, hasDatabaseBinding } from '../lib/db';
import { getMdiTier } from '../lib/report';

const viewer = await readViewerFromCookie(Astro.cookies.get(getSessionCookieName())?.value);
const databaseReady = hasDatabaseBinding();
const dashboard = databaseReady ? await getModelDashboard(10, 12) : { modelGroups: [], hottestModels: [] };

function fmt(value: number) {
  return value.toLocaleString('en-US');
}
---

<BaseLayout
  title="模型榜 - shaleme"
  description="每个模型下最会附和的账号，按样本量收缩后的分数排名。"
>
  <div class="wrap">
    <header class="masthead">
      <div class="masthead-main">
        <div>
          <span class="brand">SHALEME<span class="sub">模型榜</span></span>
          <h1>按模型拆开看</h1>
        </div>
        <div class="head-side">
          <a class="btn" href="/">← 榜单</a>
          {
            viewer ? (
              <a class="viewer" href={`/u/${encodeURIComponent(viewer.login)}`} data-tip="我的成绩">
                <img src={viewer.avatarUrl} alt="" width="30" height="30" />
              </a>
            ) : (
              <a class="btn" href="/api/auth/github/login">GitHub 登录</a>
            )
          }
        </div>
      </div>
    </header>

    {
      !databaseReady || dashboard.modelGroups.length === 0 ? (
        <div class="empty-state">
          <p>还没有带模型明细的提交。</p>
          <a class="btn" href="/upload">怎么上榜 →</a>
        </div>
      ) : (
        dashboard.modelGroups.map((group) => (
          <section class="panel" id={group.model}>
            <div class="panel-head">
              <h2 class="model-title num">{group.model}</h2>
              {
                group.rows[0] && (
                  <span class="panel-top">
                    榜首 <span class="num">{group.rows[0].score.toFixed(1)}</span>
                  </span>
                )
              }
            </div>
            <table>
              <thead>
                <tr>
                  <th class="col-rank"></th>
                  <th>账号</th>
                  <th class="right">命中</th>
                  <th class="right">消息</th>
                  <th class="right">分数</th>
                </tr>
              </thead>
              <tbody>
                {group.rows.map((entry) => {
                  const tier = getMdiTier(entry.score);
                  return (
                    <tr>
                      <td class="col-rank">
                        <span class:list={['rank-num', 'num', entry.rank <= 3 && 'podium']}>
                          {entry.rank}
                        </span>
                      </td>
                      <td>
                        <a class="who" href={`/u/${encodeURIComponent(entry.login)}`}>
                          <img src={entry.avatarUrl} alt="" width="26" height="26" loading="lazy" />
                          <span>{entry.displayName}</span>
                        </a>
                      </td>
                      <td class="right num">{fmt(entry.droolCount)}</td>
                      <td class="right num muted">{fmt(entry.assistantMessages)}</td>
                      <td class="right">
                        <span class="score num" data-tip={`原始 MDI ${entry.mdi.toFixed(2)}`}>
                          {entry.score.toFixed(1)}
                        </span>
                        <span class="tier" style={`color:${tier.color};`}>{tier.badge}</span>
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </section>
        ))
      )
    }

    <footer class="foot">
      同一账号在同一模型上只取最好的一次 · 分数按样本量收缩 ·{" "}
      <a href="https://github.com/Crosery/shaleme">源码</a>
    </footer>
  </div>
</BaseLayout>

<style>
  .masthead {
    padding: 44px 0 28px;
    border-bottom: 1px solid var(--line);
  }
  .masthead-main {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--s-5);
  }
  .brand {
    font-family: var(--font-serif);
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: 0.08em;
  }
  .brand .sub {
    font-family: var(--font-sans);
    font-size: 0.82rem;
    font-weight: 400;
    letter-spacing: 0;
    color: var(--ink-3);
    margin-left: 10px;
  }
  h1 {
    font-family: var(--font-serif);
    font-size: var(--fs-3xl);
    font-weight: 700;
    line-height: 1.35;
    margin-top: 14px;
  }
  .head-side { display: flex; align-items: center; gap: var(--s-3); }
  .viewer img { border-radius: 999px; border: 1px solid var(--line); }

  .panel { margin-top: var(--s-7); }
  .panel-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: var(--s-3);
  }
  .model-title {
    font-size: var(--fs-xl);
    font-weight: 700;
    letter-spacing: -0.01em;
  }
  .panel-top { color: var(--ink-3); font-size: var(--fs-sm); }
  .panel-top .num { color: var(--ink); font-weight: 700; }

  .col-rank { width: 56px; }
  .rank-num { font-size: 0.95rem; color: var(--ink-3); font-weight: 700; }
  .rank-num.podium {
    font-family: var(--font-serif);
    font-size: 1.7rem;
    color: var(--ink);
    line-height: 1;
  }
  .who {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    font-weight: 600;
  }
  .who img { border-radius: 999px; }
  .who:hover { color: var(--accent-strong); }
  .muted { color: var(--ink-3); }
  .score { font-size: 1.05rem; font-weight: 700; letter-spacing: -0.01em; }
  .tier { display: block; font-size: 0.72rem; font-weight: 600; line-height: 1.4; }

  .foot {
    margin-top: var(--s-8);
    padding-top: var(--s-4);
    border-top: 1px solid var(--line);
    color: var(--ink-3);
    font-size: var(--fs-xs);
  }
  .foot a { color: inherit; }

  @media (max-width: 720px) {
    .tier { display: none; }
    td.right, th.right { padding-left: 8px; padding-right: 8px; }
  }
</style>
