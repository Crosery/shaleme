{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "shaleme-leaderboard",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-04-13",
  "compatibility_flags": ["nodejs_compat"],
  // workers.dev stays enabled so the first deploy works before a domain exists.
  // Switch to false and add a routes block once a custom domain is attached.
  "workers_dev": true,
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "vars": {
    // Empty means "use the origin of the incoming request", which is correct for
    // both workers.dev and a custom domain. Set it explicitly once the canonical
    // origin is fixed; see README "配置 APP_URL".
    "APP_URL": ""
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shaleme-leaderboard",
      // Replace with the id printed by `wrangler d1 create shaleme-leaderboard`.
      "database_id": "replace-with-your-d1-database-id"
    }
  ]
}
