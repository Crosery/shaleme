{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "shaleme-leaderboard",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-04-13",
  "compatibility_flags": ["nodejs_compat"],
  // The leaderboard is served from the custom domain; workers.dev is disabled so
  // OAuth sees exactly one canonical origin.
  "workers_dev": false,
  "routes": [{ "pattern": "shaleme.crosery.cc.cd", "custom_domain": true }],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "vars": {
    // Canonical origin for the GitHub OAuth redirect_uri.
    "APP_URL": "https://shaleme.crosery.cc.cd"
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shaleme-leaderboard",
      "database_id": "3e213812-1cfd-494f-ab41-28a8910befc8"
    }
  ]
}
